#!/bin/bash
# Concatenates the per-role <role>/Dockerfile files into the root multi-stage
# Dockerfile, rewriting each published `FROM curatorium/...` to its local build
# stage and role-prefixing every relative COPY source. Edit the per-role
# Dockerfiles; never hand-edit the generated root one.
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")"

ROLES=(base ci az-ci php-base php-qa php-fs)
declare -A PARENT=(
	[base]="debian:bookworm-slim"
	[ci]="base"
	[az-ci]="ci"
	[php-base]="base"
	[php-qa]="php-base"
	[php-fs]="php-qa"
)

OUT="Dockerfile"
{
	echo "# GENERATED by ./generate-dockerfile from <role>/Dockerfile — do not edit."
	echo
	echo "ARG PHPVS"
	echo "ARG NODEVS"
} >"$OUT"

for role in "${ROLES[@]}"; do
	from="FROM ${PARENT[$role]} AS $role"
	echo >>"$OUT"
	awk -v role="$role" -v from="$from" '
		BEGIN { seenfrom = 0 }
		/^ARG / && !seenfrom { next }
		/^FROM / && !seenfrom {
			print from
			print "LABEL org.opencontainers.image.authors=\"Curatorium\""
			print "LABEL org.opencontainers.image.vendor=\"Curatorium\""
			print "LABEL org.opencontainers.image.licenses=\"MIT\""
			print "LABEL org.opencontainers.image.source=\"https://github.com/curatorium/dockerfiles\""
			print "LABEL org.opencontainers.image.url=\"https://hub.docker.com/u/curatorium\""
			seenfrom = 1
			next
		}
		/^COPY --from=/ { print; next }
		/^COPY / {
			n = split($0, a, / +/)
			if (a[2] !~ /^\//) a[2] = role "/" a[2]
			line = a[1]
			for (i = 2; i <= n; i++) line = line " " a[i]
			print line
			next
		}
		{ print }
	' "$role/Dockerfile" >>"$OUT"
done

echo "wrote $OUT"
