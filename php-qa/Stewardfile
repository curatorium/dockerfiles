[[ "$PHPVS" != 8.0 ]] || for f in /opt/*/composer.json; do
    jq '.config.audit.ignore += $ARGS.positional' "$f" --args "${PHP80_ADVISORIES[@]}" > /tmp/composer.json && mv /tmp/composer.json "$f"
done

# composer-tools
composer --dir /opt/codecept
composer --dir /opt/composer-require-checker
composer --dir /opt/composer-unused
composer --dir /opt/easy-config
composer --dir /opt/infection
