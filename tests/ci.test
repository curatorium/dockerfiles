# shellcheck shell=bash
# shellcheck disable=SC2016  # markdown printf formats are intentionally literal
# shellcheck source=tests/.deps/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.deps/lib.sh"

# ci = the php-FREE build/deploy toolbox layered on base. No php here.
: "${IMAGE:=$(img_for ci)}"
ARCH="${X_ARCH:-$(_host_arch)}"

BINS=(docker kubectl kubectl-krew yq ejson skeema pup gron http mariadb redis-cli
      node yarn newrelic 7zz bzip2 xz zip git ssh memcstat html2markdown)
AMD64_ONLY=(q)
KREW_PLUGINS=(grep exec-cronjob krew slice split-yaml sort-manifests)

test:binaries-on-path() {
	local miss; miss=$(all_on_path "${BINS[@]}")
	[ -z "$miss" ] || { echo "not on PATH: $miss"; return 1; }
}
test:binaries-run() {
	local bad; bad=$(all_runs "${BINS[@]}")
	[ -z "$bad" ] || { echo "did not run: $bad"; return 1; }
}
test:docker-plugins() {
	runs 'docker compose' && runs 'docker buildx'
}
test:libfcgi() { emits 'ldconfig -p' 'libfcgi'; }
test:krew-plugins() {
	local p miss=""
	for p in "${KREW_PLUGINS[@]}"; do emits 'kubectl krew list 2>/dev/null' "$p" || miss+="$p "; done
	[ -z "$miss" ] || { echo "krew plugin missing: $miss"; return 1; }
}
# amd64-only tools are a hard gate on amd64 and a documented, non-blocking gap on arm64.
test:amd64-tools() {
	[ "$ARCH" = amd64 ] || { echo "amd64-only (known arm64 gap): ${AMD64_ONLY[*]}"; return 0; }
	local miss; miss=$(all_on_path "${AMD64_ONLY[@]}")
	[ -z "$miss" ] || { echo "not on PATH: $miss"; return 1; }
}

output() { cat <<MD
# ci — $IMAGE

## Binaries (On PATH · Runs)

| Binary | On PATH | Runs |
|--------|---------|------|
$(bin_rows "${BINS[@]}")

## Docker plugins · amd64-only · shared libs

| Check | Result |
|-------|--------|
| \`docker compose\` runs | $(mark runs 'docker compose') |
| \`docker buildx\` runs  | $(mark runs 'docker buildx') |
| \`q\` on PATH (amd64)   | $([ "$ARCH" = amd64 ] && mark on_path q || printf 'n/a (arm64 gap)') |
| libfcgi shared lib      | $(mark emits 'ldconfig -p' 'libfcgi') |

## kubectl-krew plugins

| Plugin | Installed |
|--------|-----------|
$(for p in "${KREW_PLUGINS[@]}"; do printf '| `%s` | %s |\n' "$p" "$(mark emits 'kubectl krew list 2>/dev/null' "$p")"; done)

## Gate

| Check | Result |
|-------|--------|
| all binaries on PATH  | $(t binaries-on-path) |
| all binaries run      | $(t binaries-run) |
| docker plugins run    | $(t docker-plugins) |
| libfcgi present       | $(t libfcgi) |
| krew plugins present  | $(t krew-plugins) |
| amd64-only tools      | $(t amd64-tools) |
MD
}
