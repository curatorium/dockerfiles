# shellcheck shell=bash
# shellcheck source=tests/.deps/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.deps/lib.sh"

# base = the OS foundation shared by every role: essentials, the fetched tools,
# and the runtime scripts. No php, no nginx — those start at php-base.
: "${IMAGE:=$(img_for base)}"

PKG_BINS=(cron gpg jq less nano patch sudo tini unzip)
FETCHED=(steward bash-test)
PRESENCE=(bash-import wait-until entrypoint service clean-tmp daemonize healthcheck envsubst-only-prefix)
ZONEINFO=/usr/share/zoneinfo/UTC

test:binaries-on-path() {
	local miss; miss=$(all_on_path "${PKG_BINS[@]}" "${FETCHED[@]}" "${PRESENCE[@]}")
	[ -z "$miss" ] || { echo "not on PATH: $miss"; return 1; }
}
test:binaries-run() {
	local bad; bad=$(all_runs "${PKG_BINS[@]}" "${FETCHED[@]}")
	[ -z "$bad" ] || { echo "did not run: $bad"; return 1; }
}
test:tzdata() { has_file "$ZONEINFO"; }

output() { cat <<MD
# base — $IMAGE

## Essentials + fetched tools (On PATH · Runs)

| Binary | On PATH | Runs |
|--------|---------|------|
$(bin_rows "${PKG_BINS[@]}" "${FETCHED[@]}")

## Helpers + runtime scripts (On PATH)

| Binary | On PATH |
|--------|---------|
$(path_rows "${PRESENCE[@]}")

## Data

| Check | Result |
|-------|--------|
| tzdata (\`$ZONEINFO\`) | $(mark has_file "$ZONEINFO") |

## Gate

| Check | Result |
|-------|--------|
| all binaries on PATH | $(t binaries-on-path) |
| all binaries run     | $(t binaries-run) |
| tzdata present       | $(t tzdata) |
MD
}
